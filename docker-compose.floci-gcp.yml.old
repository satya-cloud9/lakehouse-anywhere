services:
  floci-gcp:
    image: floci/floci-gcp:latest   # pin a version once this has been run once
    container_name: lakehouse-floci-gcp
    ports:
      - "4588:4588"   # all 25 emulated GCP services, one endpoint -- see https://floci.io/gcp/
    environment:
      - FLOCI_STORAGE_MODE=hybrid
      - FLOCI_STORAGE_PERSISTENT_PATH=/app/data
    volumes:
      - "floci-gcp-data:/app/data"
      # Confirmed via container logs (GkeClusterManager/DockerClientProducer):
      # floci-gcp's GKE emulation actually launches a sibling `rancher/k3s`
      # container on the HOST's Docker daemon per cluster created, rather
      # than faking API responses -- the same Docker-outside-of-Docker
      # pattern this repo already uses for `kind` on the AWS side, just one
      # layer further down (floci-gcp itself creates the container, not a
      # script on the host). Without this mount, DockerClientProducer's
      # connection to unix:///var/run/docker.sock fails with a
      # SocketException, and the cluster lands in ERROR state instead of
      # an obvious startup error -- confirmed directly from this container's
      # own logs, not a guess.
      - "/var/run/docker.sock:/var/run/docker.sock"
    healthcheck:
      # Assumes floci-gcp shares floci's /_localstack/health convention --
      # unconfirmed for this sibling project specifically (same caveat as
      # before). Separately, confirmed the floci image family ships no
      # curl/wget/python3 -- only bash + coreutils -- so this uses bash's
      # built-in /dev/tcp instead, same as docker-compose.floci.yml.
      test:
        - CMD
        - bash
        - -c
        - >-
          exec 3<>/dev/tcp/127.0.0.1/4588 &&
          printf 'GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 &&
          response=$(head -c 15 <&3) &&
          [[ "$$response" == *"200 OK"* ]]
      interval: 5s
      timeout: 5s
      retries: 20

volumes:
  floci-gcp-data:
